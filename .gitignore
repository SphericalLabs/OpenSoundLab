# Based on https://github.com/github/gitignore/blob/master/Unity.gitignore

# Project-local documentation and test content
/docs
/Samples/Testing
/Goals/

# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Unity generated files
sysinfo.txt
crashlytics-build.properties
*.pidb.meta
*.pdb.meta
*.mdb.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data.
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored.
#!/[Aa]ssets/**/*.meta

# Unity build outputs and packages
*.apk
*.aab
*.unitypackage

# Unity asset pipeline outputs
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/[Ss]treamingAssets/[Ee]xamples.tgz*
/[Aa]ssets/[Ss]treamingAssets/[Ss]amples.tgz*

# Unity and IDE generated project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE and tool caches
.gradle/
.vs/
.vsconfig
/[Aa]ssets/Plugins/Editor/JetBrains*
AGENTS.md

# Asset Store and local plugins
/Assets/AssetStoreTools*
/Assets/Plugins/SuperPivot/
!/Assets/third_party/RuntimeAudioClipLoader/Plugins/*

# Project-local generated or private assets
/Assets/Debug
/Assets/Debug.meta
/Assets/Resources/Personalization/*
/Assets/StreamingAssets/Tutorials/*.mp4*
/Assets/Textures/Environments
/Assets/Textures/Environments.meta

# Android signing
*user.keystore
/Assets/Editor/Android_Code_Signing.cs
/Assets/Editor/Android_Code_Signing.cs.meta

# Windows generated files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS generated files
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Xcode generated files
**/xcuserdata/
*.xcscmblueprint
*.xccheckout
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
/*.gcno
**/xcshareddata/WorkspaceSettings.xcsettings

# OSLNative build outputs
/OSLNative/OSLNative
/OSLNative/Build/obj/
/OSLNative/libs/
/OSLNative/obj/
/OSLNative/x64/
/OSLNative/Xcode/build/
/Assets/Plugins/OSLNative/arm64/Release/libOSLNative.so
/Assets/Plugins/OSLNative/arm64/Release/libOSLNative.so.meta
/Assets/Plugins/OSLNative/macos/Release/libOSLNative.dylib
/Assets/Plugins/OSLNative/macos/Release/libOSLNative.dylib.meta
/Assets/Plugins/OSLNative/x64/Release/OSLNative.dll
/Assets/Plugins/OSLNative/x64/Release/OSLNative.dll.meta
/Assets/Plugins/OSLNative/x64/Release/OSLNative.exp*
/Assets/Plugins/OSLNative/x64/Release/OSLNative.lib*
/Assets/Plugins/OSLNative/x64/Release/OSLNative.pdb*
/Assets/Plugins/OSLNative/macos/arm64 x86_64/*
!/Assets/Plugins/OSLNative/macos/arm64 x86_64/Release/
/Assets/Plugins/OSLNative/macos/arm64 x86_64/Release/*
!/Assets/Plugins/OSLNative/macos/arm64 x86_64/Release/libOSLNative.dylib
!/Assets/Plugins/OSLNative/macos/arm64 x86_64/Release/libOSLNative.dylib.meta

# OpenResonance generated Unity package, legacy install and build outputs
/OpenResonanceBuild/Build/
/OpenResonanceBuild/Package/
/OpenResonanceBuild/Staging/
/Assets/ResonanceAudio/
/Assets/ResonanceAudio.meta
